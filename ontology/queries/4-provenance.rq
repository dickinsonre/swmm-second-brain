# Where the statements come from: each source page, who drafted it ("unknown" when its page has no drafted_by line), and whether Bob has reviewed it
PREFIX sb: <https://github.com/dickinsonre/swmm-second-brain/ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?source ?author ?drafted_by ?reviewed (COUNT(*) AS ?statements) WHERE {
  GRAPH ?g { ?s ?p ?o . FILTER(isIRI(?s)) }
  ?g dcterms:identifier ?source ; sb:draftedBy ?drafted_by ; sb:reviewed ?reviewed .
  OPTIONAL { ?g dcterms:creator ?a }
  BIND(COALESCE(?a, "unknown") AS ?author)
}
GROUP BY ?source ?author ?drafted_by ?reviewed
ORDER BY ?source
